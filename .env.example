# Core runtime
NODE_ENV=development
PORT=8080

# Database (required in production)
# Example: postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Frontend / auth
APP_BASE_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
MAGICLINK_TOKEN_TTL_MIN=15
SESSION_DAYS=14

# Magic-link email delivery (set in production)
# Option A: SMTP connection URL
SMTP_URL=
# Option B: Host/port auth settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAGICLINK_FROM_EMAIL=no-reply@example.com

# Admin access
ADMIN_EMAILS=admin@example.com

# Dev-only helper (non-production only)
DEV_DEBUG_AUTH_START_TOKEN=false

# Optional Stripe automation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional file storage (S3/R2)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional frontend override
# VITE_API_BASE_URL=http://localhost:8080

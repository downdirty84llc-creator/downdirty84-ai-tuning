# Down Dirty 84 — environment template.
# Copy to .env (never commit the copy) and fill in.
# The server refuses to start in production if a REQUIRED value is missing —
# see backend/src/config/env.ts. That is deliberate: a half-configured
# deployment that boots is worse than one that tells you what is missing.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Postgres. Managed Postgres providers give you this string directly.
DATABASE_URL=postgresql://user:password@host:5432/dd84

# Who may release calibrations and see the admin queue. Comma-separated.
# Env-only on purpose: admin rights must not be grantable by anything the
# application itself can write to.
ADMIN_EMAILS=you@downdirty84llc.com

# Public URL of the frontend. Used in magic-link emails and CORS.
APP_BASE_URL=https://app.downdirty84llc.com
FRONTEND_ORIGIN=https://app.downdirty84llc.com

# Outbound email. Sign-in is a magic link, so with no transport nobody can log
# in — not a customer, not you. It also carries "your change list is ready",
# which is the last email you would otherwise write by hand on every job.
# Get a key at resend.com, verify your sending domain, then set both.
# Leave blank in development: links print to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Down Dirty 84 <noreply@downdirty84llc.com>


# ── FILE STORAGE ────────────────────────────────────────────────────────────
# Without these, uploads go to local disk, which is WIPED ON EVERY RESTART on
# Render/Heroku/Fly. Customer logs would silently vanish. Set them before
# taking real work.

S3_BUCKET=dd84-uploads
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ── PAYMENTS ────────────────────────────────────────────────────────────────
# Webhook endpoint: POST /api/v1/stripe/webhook
# Point Stripe at it and subscribe to checkout.session.completed.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ── OPTIONAL ────────────────────────────────────────────────────────────────

PORT=8080
SESSION_DAYS=14
MAGICLINK_TOKEN_TTL_MIN=15

# Where local uploads go when S3 is not configured. Development only.
LOCAL_UPLOAD_DIR=./tmp_uploads
